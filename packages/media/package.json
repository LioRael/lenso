{
  "name": "@lenso/media",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso.git",
    "directory": "packages/media"
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "default": "./dist/files.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "default": "./dist/tasks.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "default": "./dist/d1.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/processor.ts src/files.ts src/tasks.ts src/d1.ts src/bun.ts src/sharp-child.ts src/sqlite.ts --outdir dist --target browser --external 'node:*' --external 'bun:*' --packages external --splitting && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test",
    "benchmark": "bun scripts/benchmark-native.ts"
  },
  "dependencies": {
    "@lenso/core": "workspace:^",
    "@lenso/storage": "workspace:^",
    "@lenso/tasks": "workspace:^",
    "@standard-schema/spec": "1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "drizzle-orm": "0.45.3",
    "miniflare": "5.20261006.0-alpha",
    "sharp": "0.35.5"
  },
  "peerDependencies": {
    "sharp": "0.35.5"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  }
}
