{
  "name": "@lenso/limits",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso.git",
    "directory": "packages/limits"
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "import": "./dist/d1.js"
    },
    "./migrations/*": "./migrations/*"
  },
  "scripts": {
    "build": "bun build src/index.ts src/sqlite.ts src/postgres.ts src/d1.ts --outdir dist --target browser --packages external --splitting && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun run build && bun test test"
  },
  "dependencies": {
    "@lenso/core": "workspace:^",
    "@standard-schema/spec": "1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@lenso/auth": "workspace:^",
    "@lenso/db": "workspace:^",
    "@lenso/workers": "workspace:^",
    "drizzle-orm": "0.45.3",
    "miniflare": "5.20261006.0-alpha"
  },
  "peerDependencies": {
    "drizzle-orm": "0.45.3"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  }
}
