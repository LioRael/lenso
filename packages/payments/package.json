{
  "name": "@lenso/payments",
  "version": "0.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso.git",
    "directory": "packages/payments"
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stripe": {
      "types": "./dist/stripe.d.ts",
      "default": "./dist/stripe.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "default": "./dist/tasks.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "default": "./dist/scheduler.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./manage": {
      "types": "./dist/manage.d.ts",
      "default": "./dist/manage.js"
    },
    "./drizzle/pg": {
      "types": "./dist/drizzle/pg.d.ts",
      "default": "./dist/drizzle/pg.js"
    },
    "./drizzle/sqlite": {
      "types": "./dist/drizzle/sqlite.d.ts",
      "default": "./dist/drizzle/sqlite.js"
    },
    "./drizzle/d1": {
      "types": "./dist/drizzle/d1.d.ts",
      "default": "./dist/drizzle/d1.js"
    },
    "./migrations/*": "./migrations/*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun build src/index.ts src/stripe.ts src/plugin.ts src/auth.ts src/config.ts src/tasks.ts src/scheduler.ts src/fetch.ts src/manage.ts src/drizzle/pg.ts src/drizzle/sqlite.ts src/drizzle/d1.ts --root src --outdir dist --target browser --packages external --splitting",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@lenso/auth": "workspace:^",
    "@lenso/core": "workspace:^",
    "@lenso/engine": "workspace:^",
    "@lenso/manage": "workspace:^",
    "@lenso/scheduler": "workspace:^",
    "@lenso/tasks": "workspace:^",
    "drizzle-orm": "0.45.3",
    "miniflare": "5.20261006.0-alpha",
    "stripe": "23.0.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@lenso/auth": "^0.3.1",
    "@lenso/core": "^0.3.0",
    "@lenso/engine": "^0.4.0",
    "@lenso/manage": "^0.4.0",
    "@lenso/scheduler": "^0.2.1",
    "@lenso/tasks": "^0.3.1",
    "drizzle-orm": "0.45.3",
    "stripe": "23.0.0",
    "zod": "4.6.5"
  },
