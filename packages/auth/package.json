{
  "name": "@lenso/auth",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso.git",
    "directory": "packages/auth"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./orpc": {
      "types": "./dist/orpc.d.ts",
      "default": "./dist/orpc.js"
    },
    "./session-source": {
      "types": "./dist/session-source.d.ts",
      "default": "./dist/session-source.js"
    },
    "./sessions": {
      "types": "./dist/sessions.d.ts",
      "default": "./dist/sessions.js"
    },
    "./drizzle/pg": {
      "types": "./dist/drizzle/pg.d.ts",
      "default": "./dist/drizzle/pg.js"
    },
    "./drizzle/sqlite": {
      "types": "./dist/drizzle/sqlite.d.ts",
      "default": "./dist/drizzle/sqlite.js"
    },
    "./drizzle/d1": {
      "types": "./dist/drizzle/d1.d.ts",
      "default": "./dist/drizzle/d1.js"
    },
    "./drizzle/schema-pg": {
      "types": "./dist/drizzle/schema-pg.d.ts",
      "default": "./dist/drizzle/schema-pg.js"
    },
    "./drizzle/schema-sqlite": {
      "types": "./dist/drizzle/schema-sqlite.d.ts",
      "default": "./dist/drizzle/schema-sqlite.js"
    },
    "./migrations/*": "./migrations/*"
  },
  "scripts": {
    "build": "bun -e \"await import('node:fs/promises').then(({rm}) => rm('dist', {recursive: true, force: true}))\" && tsc -p tsconfig.build.json && bun build src/index.ts src/plugin.ts src/fetch.ts src/orpc.ts src/session-source.ts src/sessions.ts src/drizzle/pg.ts src/drizzle/sqlite.ts src/drizzle/d1.ts src/drizzle/schema-pg.ts src/drizzle/schema-sqlite.ts --root src --outdir dist --target browser --packages external --splitting",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@lenso/core": "workspace:^",
    "@lenso/web": "workspace:^",
    "@orpc/server": "2.0.0-beta.42",
    "drizzle-orm": "0.45.3",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@lenso/core": "^0.2.1",
    "@orpc/server": "2.0.0-beta.42",
    "drizzle-orm": "^0.45.3"
  },
  "peerDependenciesMeta": {
    "@orpc/server": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "@lenso/core": {
      "optional": true
    }
  }
}
