{
  "name": "@lenso/web",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso.git",
    "directory": "packages/web"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun build src/index.ts --outdir dist --target bun --packages external && bun build src/client.ts --outdir dist --target browser --packages external && bun build src/bun.ts --outdir dist --target bun --packages external",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@lenso/core": "workspace:^",
    "@opentelemetry/api": "1.9.1",
    "@orpc/client": "2.0.0-beta.42",
    "@orpc/server": "2.0.0-beta.42"
  },
  "devDependencies": {
    "@lenso/otel": "workspace:^",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "zod": "4.6.5"
  }
}
