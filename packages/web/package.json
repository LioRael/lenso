{
  "name": "@lenso/web",
  "version": "0.3.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso.git",
    "directory": "packages/web"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "lenso-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "lenso-source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./bun": {
      "lenso-source": "./src/bun.ts",
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./openapi": {
      "lenso-source": "./src/openapi.ts",
      "types": "./dist/openapi.d.ts",
      "default": "./dist/openapi.js"
    },
    "./problem-details": {
      "lenso-source": "./src/problem-details.ts",
      "types": "./dist/problem-details.d.ts",
      "default": "./dist/problem-details.js"
    },
    "./openapi-client": {
      "lenso-source": "./src/openapi-client.ts",
      "types": "./dist/openapi-client.d.ts",
      "default": "./dist/openapi-client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun build src/index.ts src/openapi.ts src/problem-details.ts --outdir dist --target bun --packages external && bun build src/client.ts src/openapi-client.ts --outdir dist --target browser --packages external && bun build src/bun.ts --outdir dist --target bun --packages external",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@lenso/core": "workspace:^",
    "@opentelemetry/api": "1.9.1",
    "@orpc/client": "2.0.0-beta.42",
    "@orpc/server": "2.0.0-beta.42"
  },
  "devDependencies": {
    "@lenso/otel": "workspace:^",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@orpc/openapi": "2.0.0-beta.42",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@orpc/openapi": "2.0.0-beta.42"
  },
  "peerDependenciesMeta": {
    "@orpc/openapi": {
      "optional": true
    }
  }
}
