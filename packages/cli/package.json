{
  "name": "lenso-cli",
  "version": "0.1.0",
  "private": false,
  "bin": {
    "lenso": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/dev-ready.d.ts",
      "import": "./dist/dev-ready.js"
    },
    "./engine": {
      "types": "./dist/engine-authoring.d.ts",
      "import": "./dist/engine-authoring.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/bin.ts src/index.ts src/dev-ready.ts src/engine-authoring.ts --outdir dist --target bun --packages external && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@lenso/engine": "workspace:^",
    "lenso": "workspace:^",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "zod": "4.6.5"
  }
}
