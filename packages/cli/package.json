{
  "name": "@lenso/cli",
  "version": "0.21.0",
  "private": false,
  "description": "TypeScript operation APIs and internal Bun adapter for the Rust lenso command",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "examples"
  ],
  "type": "module",
  "exports": {
    ".": {
      "lenso-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter": {
      "lenso-source": "./src/adapter.ts",
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/adapter.ts src/index.ts --outdir dist --target bun --packages external && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@lenso/core": "workspace:^",
    "@lenso/engine": "workspace:^",
    "@opentelemetry/api": "1.9.1",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@lenso/auth": "workspace:^",
    "@lenso/manage": "workspace:^",
    "@lenso/web": "workspace:^",
    "@orpc/server": "2.0.0-beta.42",
    "zod": "4.6.5"
  }
}
