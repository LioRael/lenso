{
  "name": "@lenso/mcp",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso.git",
    "directory": "packages/mcp"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target bun --packages external && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@lenso/cli": "workspace:^",
    "@lenso/core": "workspace:^",
    "@lenso/engine": "workspace:^",
    "@lenso/manage": "workspace:^",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  }
}
