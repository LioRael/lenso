{
  "name": "@lenso/core",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso.git",
    "directory": "packages/lenso"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./config/env": {
      "types": "./dist/config-env.d.ts",
      "import": "./dist/config-env.js"
    },
    "./config/file": {
      "types": "./dist/config-file.d.ts",
      "import": "./dist/config-file.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts src/plugin.ts src/browser.ts src/config.ts src/config-env.ts src/config-file.ts --outdir dist --target browser --packages external --splitting && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@standard-schema/spec": "1.1.0"
  }
}
