{
  "name": "@lenso/scheduler",
  "version": "0.3.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso.git",
    "directory": "packages/scheduler"
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "import": "./dist/d1.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./driver": {
      "types": "./dist/driver.d.ts",
      "import": "./dist/driver.js"
    },
    "./manage": {
      "types": "./dist/manage.d.ts",
      "import": "./dist/manage.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/postgres.ts src/d1.ts src/plugin.ts src/driver.ts src/manage.ts --outdir dist --target bun --packages external --splitting && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test && bun run test:d1",
    "test:d1": "bun build test/fixtures/d1-worker.ts --target browser --external 'node:*' --outdir .lenso/workerd && node --experimental-strip-types --test test/d1.workerd.mjs"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "cron-parser": "5.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@lenso/auth": "workspace:^",
    "@lenso/core": "workspace:^",
    "@lenso/engine": "workspace:^",
    "@lenso/manage": "workspace:^",
    "@lenso/tasks": "workspace:^",
    "@types/pg": "8.23.1",
    "drizzle-orm": "0.45.3",
    "miniflare": "5.20261006.0-alpha",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@lenso/auth": "workspace:^",
    "@lenso/core": "workspace:^",
    "@lenso/engine": "workspace:^",
    "@lenso/manage": "workspace:^",
    "@lenso/tasks": "workspace:^",
    "drizzle-orm": "0.45.3",
    "zod": "4.6.5"
  },
  "peerDependenciesMeta": {
    "@lenso/engine": {
      "optional": true
    },
    "@lenso/manage": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "@lenso/core": {
      "optional": true
    },
    "@lenso/auth": {
      "optional": true
    },
    "@lenso/tasks": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  }
}
