{
  "name": "@lenso/tasks",
  "version": "0.1.0",
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/postgres.ts --outdir dist --target bun --packages external --splitting && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "drizzle-orm": "0.45.3",
    "lenso": "workspace:^",
    "pg": "8.23.1",
    "pg-boss": "12.37.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "zod": "4.6.5"
  }
}
