{
  "name": "lenso-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && bun run release:typecheck",
    "test": "turbo run test && bun run release:test",
    "generate": "bun packages/cli/src/bin.ts generate --root examples/greeting",
    "dev": "bun run build && bun packages/cli/src/bin.ts dev --root examples/greeting",
    "cli": "bun packages/cli/src/bin.ts",
    "client": "bun examples/greeting/src/client.ts",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "changeset": "bun node_modules/@changesets/cli/bin.js add",
    "release:status": "bun node_modules/@changesets/cli/bin.js status",
    "release:version": "bun node_modules/@changesets/cli/bin.js version",
    "release:verify": "bun scripts/release-verify.ts",
    "release:typecheck": "tsc --noEmit -p scripts/tsconfig.json",
    "release:test": "bun test scripts/release.test.ts scripts/release-ci.test.ts scripts/release-select.test.ts",
    "release:prepare": "bun scripts/release-ci.ts prepare"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
