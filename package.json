{
  "name": "lenso-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    ".runtime-deps/sdk"
  ],
  "scripts": {
    "prepare:runtime": "bun scripts/prepare-runtime.ts",
    "runtime:typecheck": "tsc --noEmit -p scripts/tsconfig.json",
    "runtime:test": "bun test scripts/prepare-runtime.test.ts",
    "dev:runtime": "bun scripts/dev-runtime-workspace.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && bun run release:typecheck",
    "test": "turbo run test && bun run release:test",
    "generate": "bun --eval \"import {generate} from '@lenso/engine'; await generate('examples/greeting')\"",
    "dev": "bun run build && lenso dev --root examples/greeting",
    "client": "bun examples/greeting/src/client.ts",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "changeset": "bun node_modules/@changesets/cli/bin.js add",
    "release:status": "bun scripts/release-version.ts status",
    "release:version": "bun scripts/release-version.ts version",
    "release:verify": "bun scripts/release-verify.ts",
    "release:typecheck": "tsc --noEmit -p scripts/tsconfig.json",
    "release:test": "bun test scripts/release.test.ts scripts/release-ci.test.ts scripts/release-select.test.ts",
    "release:prepare": "bun scripts/release-ci.ts prepare"
  },
  "devDependencies": {
    "@changesets/apply-release-plan": "8.1.1",
    "@changesets/assemble-release-plan": "7.0.0",
    "@changesets/cli": "3.0.3",
    "@changesets/config": "4.0.1",
    "@changesets/read": "1.0.1",
    "@lenso/runtime-sdk": "workspace:*",
    "@manypkg/get-packages": "3.1.0",
    "@types/bun": "1.4.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.3"
  },
  "packageManager": "bun@1.4.3"
}
