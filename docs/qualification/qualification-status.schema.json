{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lenso qualification status ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "records"
  ],
  "properties": {
    "$schema": {
      "const": "./qualification-status.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "records": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9.-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "paths"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "revision": {
          "$ref": "#/$defs/sha"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/).+"
          }
        },
        "cohort": {
          "$ref": "#/$defs/cohortRef"
        }
      }
    },
    "cohortRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "snapshot_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_ref",
        "assertion"
      ],
      "properties": {
        "kind": {
          "enum": [
            "test",
            "deployment",
            "artifact",
            "document",
            "inspection"
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/sourceRef"
        },
        "assertion": {
          "type": "string",
          "minLength": 1
        },
        "receipt": {
          "$ref": "#/$defs/receiptRef"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "url",
        "receipt"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://.+"
        },
        "receipt": {
          "$ref": "#/$defs/receiptRef"
        }
      }
    },
    "receiptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decision_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "designed",
            "not_assessed",
            "conflicted"
          ]
        },
        "decision_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "designed"
              }
            }
          },
          "then": {
            "properties": {
              "decision_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "implemented",
            "not_assessed",
            "conflicted"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "implemented"
              }
            }
          },
          "then": {
            "properties": {
              "source_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifact",
        "version",
        "source_refs",
        "evidence",
        "publication",
        "known_limitations"
      ],
      "properties": {
        "status": {
          "const": "released"
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "publication": {
          "$ref": "#/$defs/publication"
        },
        "known_limitations": {
          "$ref": "#/$defs/limitations"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification"
      ],
      "properties": {
        "id": {
          "enum": [
            "native",
            "cloudflare-workers",
            "simulated"
          ]
        },
        "classification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "implementation"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "combination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "infrastructure"
      ],
      "properties": {
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "infrastructure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/infrastructure"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "combination",
        "source_refs",
        "evidence",
        "known_limitations"
      ],
      "properties": {
        "level": {
          "enum": [
            "local",
            "target",
            "production"
          ]
        },
        "combination": {
          "$ref": "#/$defs/combination"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "known_limitations": {
          "allOf": [
            {
              "$ref": "#/$defs/limitations"
            },
            {
              "minItems": 1
            }
          ]
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "title"
      ],
      "properties": {
        "kind": {
          "enum": [
            "capability",
            "execution-profile",
            "composition"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "design",
        "implementation",
        "releases",
        "qualifications",
        "known_limitations"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "design": {
          "$ref": "#/$defs/design"
        },
        "implementation": {
          "$ref": "#/$defs/implementation"
        },
        "releases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/release"
          }
        },
        "qualifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qualification"
          }
        },
        "known_limitations": {
          "$ref": "#/$defs/limitations"
        }
      }
    }
  }
}
