{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lenso exact release cohort receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "id",
    "state",
    "source_closure",
    "artifact_closure",
    "stages",
    "known_limitations"
  ],
  "properties": {
    "$schema": {
      "const": "../release-cohort.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "state": {
      "enum": [
        "candidate",
        "release-ready",
        "published"
      ]
    },
    "source_closure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "artifact_closure": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source-closure",
        "artifact-digest",
        "clean-room-install",
        "real-package-install",
        "startup",
        "shutdown",
        "upgrade"
      ],
      "properties": {
        "source-closure": {
          "$ref": "#/$defs/stage"
        },
        "artifact-digest": {
          "$ref": "#/$defs/stage"
        },
        "clean-room-install": {
          "$ref": "#/$defs/stage"
        },
        "real-package-install": {
          "$ref": "#/$defs/stage"
        },
        "startup": {
          "$ref": "#/$defs/stage"
        },
        "shutdown": {
          "$ref": "#/$defs/stage"
        },
        "upgrade": {
          "$ref": "#/$defs/stage"
        }
      }
    },
    "known_limitations": {
      "$ref": "#/$defs/limitations"
    },
    "publications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/publication"
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "algorithm",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "committed",
            "working-tree"
          ]
        },
        "algorithm": {
          "const": "lenso.git-worktree-snapshot-v1"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "snapshot",
        "coordinates"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "revision": {
          "$ref": "#/$defs/sha"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifact-source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "snapshot_digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "revision": {
          "$ref": "#/$defs/sha"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate",
        "kind",
        "source",
        "digest",
        "bytes"
      ],
      "properties": {
        "coordinate": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "cargo-crate",
            "npm-tarball",
            "binary",
            "wasm",
            "bundle"
          ]
        },
        "source": {
          "$ref": "#/$defs/artifact-source"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "assertion"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "assertion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate",
        "registry",
        "url",
        "receipt"
      ],
      "properties": {
        "coordinate": {
          "type": "string",
          "minLength": 1
        },
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://.+"
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "not-run",
            "blocked",
            "not-applicable"
          ]
        },
        "receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/receipt"
          }
        },
        "known_limitations": {
          "$ref": "#/$defs/limitations"
        },
        "not_applicable_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not-applicable"
              }
            }
          },
          "then": {
            "required": [
              "not_applicable_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "not-run",
                  "blocked"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "not_applicable_reason"
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "published"
          }
        }
      },
      "then": {
        "required": [
          "publications"
        ],
        "properties": {
          "publications": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "candidate"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "publications"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "release-ready"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "publications"
          ]
        }
      }
    }
  ]
}
