    },
    "accepted_verifier_workflows": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "policy_revision": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "protocol": {
      "const": "lenso.module-verification-profile.v1",
      "type": "string"
    },
    "required_checks": {
      "additionalProperties": false,
      "properties": {
        "fresh_install": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "restore": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "uninstall": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "upgrade": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "protocol",
    "profile_id",
    "policy_revision",
    "required_checks",
    "accepted_verifier_repository_ids",
    "accepted_verifier_workflows"
