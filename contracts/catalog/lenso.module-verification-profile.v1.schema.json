{
  "$id": "https://contracts.lenso.local/catalog/lenso.module-verification-profile.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_verifier_repository_ids": {
