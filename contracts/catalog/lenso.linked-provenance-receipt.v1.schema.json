{
  "$defs": {
    "ArtifactAttestationEvidence": {
      "additionalProperties": false,
      "properties": {
        "attestation": {
          "$ref": "#/$defs/AttestationReference"
        },
        "commit_sha": {
          "type": "string"
        },
        "oidc_issuer": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "repository_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "run_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "runner_environment": {
          "type": "string"
        },
        "workflow": {
          "type": "string"
        }
      },
      "required": [
        "attestation",
        "repository",
        "repository_id",
        "workflow",
        "run_id",
        "commit_sha",
        "oidc_issuer",
        "runner_environment"
      ],
      "type": "object"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "locator": {
          "type": "string"
        }
      },
      "required": [
        "locator",
        "digest"
      ],
      "type": "object"
    },
    "AttestationReference": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "signer": {
          "type": "string"
        }
      },
      "required": [
        "locator",
        "digest",
        "issuer",
        "signer"
      ],
      "type": "object"
    },
    "CleanBuildEvidence": {
      "additionalProperties": false,
      "properties": {
        "application_lock_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "builder": {
          "$ref": "#/$defs/VerifierIdentity"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/VerificationCheck"
          },
          "type": "array"
        },
        "cli_version": {
          "type": "string"
        },
        "commands": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lenso_version": {
          "type": "string"
        },
        "runner_image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "starter_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "toolchain": {
          "type": "string"
        }
      },
      "required": [
        "lenso_version",
        "cli_version",
        "starter_digest",
        "toolchain",
        "application_lock_digest",
        "runner_image_digest",
        "builder",
        "commands",
        "checks"
      ],
      "type": "object"
    },
    "TrustedPublishingEvidence": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "type": "string"
        },
        "oidc_issuer": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "repository_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "run_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "runner_environment": {
          "type": "string"
        },
        "runner_image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "workflow": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "repository_id",
        "workflow",
        "run_id",
        "commit_sha",
        "oidc_issuer",
        "runner_environment",
        "runner_image_digest"
      ],
      "type": "object"
    },
    "VerificationCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "type": "string"
        },
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/VerificationCheckOutcome"
        }
      },
      "required": [
        "check_id",
        "outcome",
        "duration_ms"
      ],
      "type": "object"
    },
    "VerificationCheckOutcome": {
      "enum": [
        "passed",
        "failed",
        "not_applicable"
      ],
      "type": "string"
    },
    "VerifierIdentity": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "type": "string"
        },
        "oidc_issuer": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "repository_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "run_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "signer": {
          "type": "string"
        },
        "workflow": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "repository_id",
        "workflow",
        "run_id",
        "commit_sha",
        "oidc_issuer",
        "signer"
      ],
      "type": "object"
    }
  },
  "$id": "https://contracts.lenso.local/catalog/lenso.linked-provenance-receipt.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "archive_size": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "artifact_attestation": {
      "$ref": "#/$defs/ArtifactAttestationEvidence"
    },
    "clean_build": {
      "$ref": "#/$defs/CleanBuildEvidence"
    },
    "crate_version": {
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "type": "string"
    },
    "module_release_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "package": {
      "type": "string"
    },
    "protocol": {
      "const": "lenso.linked-provenance-receipt.v1",
      "type": "string"
    },
    "publisher_id": {
      "type": "string"
    },
    "receipt_id": {
      "type": "string"
    },
    "supersedes_receipt_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "trusted_publishing": {
      "$ref": "#/$defs/TrustedPublishingEvidence"
    }
  },
  "required": [
    "protocol",
    "receipt_id",
    "issued_at",
    "publisher_id",
    "module_release_digest",
    "package",
    "crate_version",
    "archive_size",
    "archive_checksum",
    "trusted_publishing",
    "artifact_attestation",
    "clean_build"
  ],
  "title": "LensoLinkedProvenanceReceipt",
  "type": "object"
}
