{
  "$defs": {
    "ManagementActor": {
      "additionalProperties": false,
      "properties": {
        "delegatedAuthorityDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ManagementActorKind"
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "subject",
        "delegatedAuthorityDigest"
      ],
      "type": "object"
    },
    "ManagementActorKind": {
      "enum": [
        "operator",
        "automation"
      ],
      "type": "string"
    },
    "ManagementApproval": {
      "additionalProperties": false,
      "properties": {
        "approvalDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "approvalId": {
          "type": "string"
        }
      },
      "required": [
        "approvalId",
        "approvalDigest"
      ],
      "type": "object"
    },
    "ManagementIntent": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/ManagementActor"
        },
        "approvals": {
          "items": {
            "$ref": "#/$defs/ManagementApproval"
          },
          "type": "array"
        },
        "capabilityContractId": {
          "type": "string"
        },
        "capabilitySchemaDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "deadlineUnixMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "desiredOutcome": {
          "$ref": "#/$defs/RuntimeOperationDesiredOutcome"
        },
        "expectedTargetRevision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "idempotencyKey": {
          "type": "string"
        },
        "intentId": {
          "type": "string"
        },
        "protocol": {
          "const": "lenso.system-plane.runtime-operations.v1"
        },
        "serviceId": {
          "type": "string"
        },
        "serviceRevision": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/RuntimeOperationTarget"
        }
      },
      "required": [
        "protocol",
        "intentId",
        "serviceId",
        "serviceRevision",
        "target",
        "desiredOutcome",
        "expectedTargetRevision",
        "actor",
        "approvals",
        "deadlineUnixMs",
        "idempotencyKey",
        "capabilityContractId",
        "capabilitySchemaDigest"
      ],
      "type": "object"
    },
    "RuntimeOperationAcknowledgement": {
      "additionalProperties": false,
      "properties": {
        "acceptedAtUnixMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "authorizationEpoch": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "enrollmentReceiptDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "idempotencyKey": {
          "type": "string"
        },
        "intentDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "planDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "protocol": {
          "const": "lenso.system-plane.runtime-operations.v1"
        },
        "state": {
          "$ref": "#/$defs/RuntimeOperationState"
        }
      },
      "required": [
        "protocol",
        "operationId",
        "idempotencyKey",
        "intentDigest",
        "planDigest",
        "state",
        "acceptedAtUnixMs",
        "authorizationEpoch",
        "enrollmentReceiptDigest"
      ],
      "type": "object"
    },
    "RuntimeOperationAvailabilityImpact": {
      "enum": [
        "none"
      ],
      "type": "string"
    },
    "RuntimeOperationCompensationSupport": {
      "enum": [
        "not_available"
      ],
      "type": "string"
    },
    "RuntimeOperationDesiredOutcome": {
      "enum": [
        "retry"
      ],
      "type": "string"
    },
    "RuntimeOperationEvidence": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "protocol": {
          "const": "lenso.system-plane.runtime-operations.v1"
        },
        "recordedAtUnixMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "serviceId": {
          "type": "string"
        },
        "serviceRevision": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/RuntimeOperationState"
        },
        "target": {
          "$ref": "#/$defs/RuntimeOperationTarget"
        },
        "targetRevisionAfter": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetRevisionBefore": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "operationId",
        "sequence",
        "state",
        "recordedAtUnixMs",
        "serviceId",
        "serviceRevision",
        "target",
        "targetRevisionBefore",
        "code",
        "message"
      ],
      "type": "object"
    },
    "RuntimeOperationPlanReceipt": {
      "additionalProperties": false,
      "properties": {
        "approvalRequired": {
          "type": "boolean"
        },
        "availabilityImpact": {
          "$ref": "#/$defs/RuntimeOperationAvailabilityImpact"
        },
        "compensationSupport": {
          "$ref": "#/$defs/RuntimeOperationCompensationSupport"
        },
        "expectedEffects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expectedTargetRevision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "expiresAtUnixMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "intentDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "planDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "protocol": {
          "const": "lenso.system-plane.runtime-operations.v1"
        },
        "risks": {
          "items": {
            "$ref": "#/$defs/RuntimeOperationRisk"
          },
          "type": "array"
        },
        "serviceId": {
          "type": "string"
        },
        "serviceRevision": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/RuntimeOperationTarget"
        }
      },
      "required": [
        "protocol",
        "intentDigest",
        "planDigest",
        "serviceId",
        "serviceRevision",
        "target",
        "expectedTargetRevision",
        "expectedEffects",
        "risks",
        "availabilityImpact",
        "compensationSupport",
        "approvalRequired",
        "expiresAtUnixMs"
      ],
      "type": "object"
    },
    "RuntimeOperationRisk": {
      "enum": [
        "duplicate_external_effect",
        "repeated_business_notification"
      ],
      "type": "string"
    },
    "RuntimeOperationState": {
      "enum": [
        "accepted",
        "succeeded",
        "rejected",
        "failed"
      ],
      "type": "string"
    },
    "RuntimeOperationSubmission": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "$ref": "#/$defs/ManagementIntent"
        },
        "plan": {
          "$ref": "#/$defs/RuntimeOperationPlanReceipt"
        }
      },
      "required": [
        "intent",
        "plan"
      ],
      "type": "object"
    },
    "RuntimeOperationTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/RuntimeOperationTargetKind"
        },
        "targetId": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "targetId"
      ],
      "type": "object"
    },
    "RuntimeOperationTargetKind": {
      "enum": [
        "function_run",
        "outbox_event"
      ],
      "type": "string"
    },
    "RuntimeOperationTargetSnapshot": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maxAttempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "observedAtUnixMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "protocol": {
          "const": "lenso.system-plane.runtime-operations.v1"
        },
        "serviceId": {
          "type": "string"
        },
        "serviceRevision": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RuntimeOperationTargetStatus"
        },
        "target": {
          "$ref": "#/$defs/RuntimeOperationTarget"
        },
        "targetName": {
          "type": "string"
        },
        "targetRevision": {
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "serviceId",
        "serviceRevision",
        "target",
        "targetRevision",
        "observedAtUnixMs",
        "targetName",
        "status",
        "attempts",
        "maxAttempts"
      ],
      "type": "object"
    },
    "RuntimeOperationTargetStatus": {
      "enum": [
        "pending",
        "processing",
        "running",
        "completed",
        "published",
        "failed",
        "dead"
      ],
      "type": "string"
    }
  },
  "$id": "https://contracts.lenso.local/system-plane/lenso.system-plane.runtime-operations.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "document": {
          "$ref": "#/$defs/RuntimeOperationTargetSnapshot"
        },
        "kind": {
          "const": "target_snapshot",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "type": "object"
    },
    {
      "properties": {
        "document": {
          "$ref": "#/$defs/ManagementIntent"
        },
        "kind": {
          "const": "intent",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "type": "object"
    },
    {
      "properties": {
        "document": {
          "$ref": "#/$defs/RuntimeOperationPlanReceipt"
        },
        "kind": {
          "const": "plan_receipt",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "type": "object"
    },
    {
      "properties": {
        "document": {
          "$ref": "#/$defs/RuntimeOperationSubmission"
        },
        "kind": {
          "const": "submission",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "type": "object"
    },
    {
      "properties": {
        "document": {
          "$ref": "#/$defs/RuntimeOperationAcknowledgement"
        },
        "kind": {
          "const": "acknowledgement",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "type": "object"
    },
    {
      "properties": {
        "document": {
          "$ref": "#/$defs/RuntimeOperationEvidence"
        },
        "kind": {
          "const": "evidence",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "type": "object"
    }
  ],
  "title": "Lenso Runtime Operations Messages"
}
