{
  "$defs": {
    "ActionContributionResolution": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/ManagedServiceContext"
        },
        "contributions": {
          "items": {
            "$ref": "#/$defs/ResolvedActionContribution"
          },
          "type": "array"
        },
        "protocol": {
          "const": "lenso.system-plane.module-operations.v1",
          "type": "string"
        },
        "slot": {
          "type": "string"
        },
        "slotVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocol",
        "context",
        "slot",
        "slotVersion",
        "contributions"
      ],
      "type": "object"
    },
    "ActionContributionResolutionRequest": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/ManagedServiceContext"
        },
        "slot": {
          "type": "string"
        },
        "slotContext": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "slotVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "context",
        "slot",
        "slotVersion"
      ],
      "type": "object"
    },
    "ConsoleActionInputBinding": {
      "properties": {
        "input": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ConsoleActionInputValue"
        }
      },
      "required": [
        "input",
        "value"
      ],
      "type": "object"
    },
    "ConsoleActionInputValue": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "slot_context",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "ConsoleContributionAction": {
      "oneOf": [
        {
          "properties": {
            "input_bindings": {
              "default": [],
              "items": {
                "$ref": "#/$defs/ConsoleActionInputBinding"
              },
              "type": "array"
            },
            "kind": {
              "const": "admin_action",
              "type": "string"
            },
            "module": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "module",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "ManagedServiceContext": {
      "additionalProperties": false,
      "description": "The target and caller identity carried by every Module System Plane request.\nThe target Service verifies this against its authenticated transport,\nenrollment grant, and installed Module declarations before executing an\noperation.",
      "properties": {
        "callerModuleId": {
          "type": "string"
        },
        "capabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "delegatedActorSubject": {
          "type": "string"
        },
        "delegatedAuthorityDigest": {
          "type": "string"
        },
        "environmentId": {
          "type": "string"
        },
        "serviceId": {
          "type": "string"
        },
        "systemId": {
          "type": "string"
        },
        "targetServicePrincipal": {
          "type": "string"
        }
      },
      "required": [
        "systemId",
        "serviceId",
        "environmentId",
        "targetServicePrincipal",
        "callerModuleId",
        "delegatedActorSubject",
        "delegatedAuthorityDigest"
      ],
      "type": "object"
    },
    "ModuleConfigActivation": {
      "enum": [
        "none",
        "build",
        "restart",
        "service_restart"
      ],
      "type": "string"
    },
    "ModuleConfigAuditEvidence": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "moduleId": {
          "type": "string"
        },
        "newValueDigest": {
          "type": "string"
        },
        "oldValueDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "operationId": {
          "type": "string"
        },
        "recordedAtUnixMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sensitive": {
          "type": "boolean"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "operationId",
        "moduleId",
        "key",
        "sensitive",
        "newValueDigest",
        "recordedAtUnixMs"
      ],
      "type": "object"
    },
    "ModuleConfigFieldType": {
      "enum": [
        "string",
        "integer",
        "boolean",
        "json"
      ],
      "type": "string"
    },
    "ModuleConfigMutability": {
      "enum": [
        "static",
        "reloadable",
        "runtime"
      ],
      "type": "string"
    },
    "ModuleConfigReadRequest": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/ManagedServiceContext"
        },
        "keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "moduleId": {
          "type": "string"
        }
      },
      "required": [
        "context",
        "moduleId"
      ],
      "type": "object"
    },
    "ModuleConfigReadResponse": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/ManagedServiceContext"
        },
        "moduleId": {
          "type": "string"
        },
        "protocol": {
          "const": "lenso.system-plane.module-operations.v1",
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/ModuleConfigValue"
          },
          "type": "array"
        }
      },
      "required": [
        "protocol",
        "context",
        "moduleId",
        "values"
      ],
      "type": "object"
    },
    "ModuleConfigScope": {
      "enum": [
        "module",
        "service",
        "environment"
      ],
      "type": "string"
    },
    "ModuleConfigValue": {
      "additionalProperties": false,
      "properties": {
        "activation": {
          "$ref": "#/$defs/ModuleConfigActivation"
        },
        "fieldType": {
          "$ref": "#/$defs/ModuleConfigFieldType"
        },
        "key": {
          "type": "string"
        },
        "mutability": {
          "$ref": "#/$defs/ModuleConfigMutability"
        },
        "present": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/ModuleConfigScope"
        },
        "sensitive": {
          "type": "boolean"
        },
        "value": {
          "description": "Sensitive values are always omitted, including when present."
        }
      },
      "required": [
        "key",
        "fieldType",
        "scope",
        "mutability",
        "activation",
        "sensitive",
        "present"
      ],
      "type": "object"
    },
    "ModuleConfigWriteRequest": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/ManagedServiceContext"
        },
        "moduleId": {
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/ModuleConfigWriteValue"
          },
          "type": "array"
        }
      },
      "required": [
        "context",
        "moduleId",
        "values"
      ],
      "type": "object"
    },
    "ModuleConfigWriteResponse": {
      "additionalProperties": false,
      "properties": {
        "authorizationDigest": {
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/ManagedServiceContext"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ModuleConfigAuditEvidence"
          },
          "type": "array"
        },
        "moduleId": {
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "protocol": {
          "const": "lenso.system-plane.module-operations.v1",
          "type": "string"
        },
        "targetRevisionAfter": {
          "type": "string"
        },
        "targetRevisionBefore": {
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "operationId",
        "context",
        "moduleId",
        "targetRevisionBefore",
        "targetRevisionAfter",
        "authorizationDigest",
        "evidence"
      ],
      "type": "object"
    },
    "ModuleConfigWriteValue": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "value": true
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "ModuleInventoryConsoleUi": {
      "additionalProperties": false,
      "properties": {
        "artifactDigest": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "protocolMajor": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "styleAssets": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "format",
        "protocolMajor",
        "artifactDigest",
        "entry"
      ],
      "type": "object"
    },
    "ModuleInventoryDelivery": {
      "enum": [
        "linked",
        "service"
      ],
      "type": "string"
    },
    "ModuleInventoryModule": {
      "additionalProperties": false,
      "properties": {
        "consoleUi": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModuleInventoryConsoleUi"
            },
            {
              "type": "null"
            }
          ]
        },
        "delivery": {
          "$ref": "#/$defs/ModuleInventoryDelivery"
        },
        "dependencyModuleIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "manifestDigest": {
          "type": "string"
        },
        "moduleId": {
          "type": "string"
        },
        "releaseDigest": {
          "type": "string"
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/ModuleInventoryRoute"
          },
          "type": "array"
        },
        "runtimeFunctions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "runtimeStatus": {
          "$ref": "#/$defs/ModuleRuntimeStatus"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "moduleId",
        "version",
        "releaseDigest",
        "manifestDigest",
        "delivery",
        "runtimeStatus"
      ],
      "type": "object"
    },
    "ModuleInventoryRequest": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/ManagedServiceContext"
        }
      },
      "required": [
        "context"
      ],
      "type": "object"
    },
    "ModuleInventoryRoute": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "path"
      ],
      "type": "object"
    },
    "ModuleInventorySnapshot": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/ManagedServiceContext"
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/ModuleInventoryModule"
          },
          "type": "array"
        },
        "protocol": {
          "const": "lenso.system-plane.module-operations.v1",
          "type": "string"
        },
        "schemaDigest": {
          "type": "string"
        },
        "serviceRevision": {
          "type": "string"
        },
        "snapshotRevision": {
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "context",
        "serviceRevision",
        "snapshotRevision",
        "schemaDigest",
        "modules"
      ],
      "type": "object"
    },
    "ModuleRuntimeStatus": {
      "enum": [
        "active",
        "disabled",
        "degraded",
        "failed"
      ],
      "type": "string"
    },
    "ResolvedActionContribution": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ConsoleContributionAction"
        },
        "contributingModuleId": {
          "type": "string"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "requiredCapabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "target": {
          "type": "string"
        },
        "targetVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "contributingModuleId",
        "target",
        "targetVersion",
        "label",
        "action"
      ],
      "type": "object"
    }
  },
  "$id": "https://contracts.lenso.local/system-plane/lenso.system-plane.module-operations.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "document": {
          "$ref": "#/$defs/ModuleInventoryRequest"
        },
        "kind": {
          "const": "inventory_request",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "type": "object"
    },
    {
      "properties": {
        "document": {
          "$ref": "#/$defs/ModuleInventorySnapshot"
        },
        "kind": {
          "const": "inventory",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "type": "object"
    },
    {
      "properties": {
        "document": {
          "$ref": "#/$defs/ActionContributionResolutionRequest"
        },
        "kind": {
          "const": "contributions_request",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "type": "object"
    },
    {
      "properties": {
        "document": {
          "$ref": "#/$defs/ActionContributionResolution"
        },
        "kind": {
          "const": "contributions",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "type": "object"
    },
    {
      "properties": {
        "document": {
          "$ref": "#/$defs/ModuleConfigReadRequest"
        },
        "kind": {
          "const": "config_read_request",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "type": "object"
    },
    {
      "properties": {
        "document": {
          "$ref": "#/$defs/ModuleConfigReadResponse"
        },
        "kind": {
          "const": "config_read",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "type": "object"
    },
    {
      "properties": {
        "document": {
          "$ref": "#/$defs/ModuleConfigWriteRequest"
        },
        "kind": {
          "const": "config_write_request",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "type": "object"
    },
    {
      "properties": {
        "document": {
          "$ref": "#/$defs/ModuleConfigWriteResponse"
        },
        "kind": {
          "const": "config_write",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document"
      ],
      "type": "object"
    }
  ],
  "title": "Lenso Managed Service Module Operations"
}
