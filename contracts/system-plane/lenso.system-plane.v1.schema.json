{
  "$defs": {
    "CapabilityAdvertisement": {
      "additionalProperties": false,
      "properties": {
        "contractId": {
          "pattern": "^lenso\\.system-plane\\.[a-z0-9]+(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]*$",
          "type": "string"
        },
        "endpoint": {
          "pattern": "^/system-plane/v1/[a-z0-9]+(?:[/-][a-z0-9]+)*$",
          "type": "string"
        },
        "featureIds": {
          "items": {
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "majorVersion": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "schemaDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "contractId",
        "majorVersion",
        "schemaDigest",
        "endpoint"
      ],
      "type": "object"
    }
  },
  "$id": "https://contracts.lenso.local/system-plane/lenso.system-plane.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/$defs/CapabilityAdvertisement"
      },
      "type": "array"
    },
    "protocol": {
      "const": "lenso.system-plane.v1"
    },
    "serviceId": {
      "minLength": 1,
      "type": "string"
    },
    "servicePrincipal": {
      "minLength": 1,
      "type": "string"
    },
    "serviceRevision": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "serviceId",
    "servicePrincipal",
    "serviceRevision"
  ],
  "title": "Lenso System Plane Core Document",
  "type": "object"
}
