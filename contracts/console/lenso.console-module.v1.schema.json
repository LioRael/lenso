{
  "$defs": {
    "ConsoleModuleSurface": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "$ref": "#/$defs/ConsoleSurfaceArea"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "navigation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConsoleNavigation"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "requiredCapabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "path",
        "label",
        "area"
      ],
      "type": "object"
    },
    "ConsoleNavigation": {
      "properties": {
