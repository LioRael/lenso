              "$ref": "#/$defs/ConsoleNavigationGroup"
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "workspace": {
          "$ref": "#/$defs/ConsoleWorkspaceRef"
        }
      },
      "required": [
        "workspace"
      ],
      "type": "object"
    },
    "ConsoleNavigationGroup": {
      "properties": {
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "order": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    },
    "ConsoleSurfaceArea": {
      "enum": [
        "runtime",
        "operations",
        "data",
        "configuration"
      ],
      "type": "string"
    },
    "ConsoleWorkspaceRef": {
      "properties": {
        "icon": {
          "type": [
            "string",
            "null"
          ]
