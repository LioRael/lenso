  "$id": "https://contracts.lenso.local/console/lenso.console-module.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The immutable presentation manifest embedded in a `console_ui_esm`\nartifact. Its field names intentionally match the public Console SDK.",
  "properties": {
    "consoleUi": {
      "type": "string"
    },
    "hostApi": {
      "type": "string"
    },
    "moduleId": {
      "type": "string"
    },
    "protocol": {
      "const": "lenso.console-module.v1",
      "type": "string"
    },
    "surfaces": {
      "items": {
        "$ref": "#/$defs/ConsoleModuleSurface"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "protocol",
    "moduleId",
    "hostApi",
    "consoleUi",
    "surfaces"
  ],
  "title": "LensoConsoleModuleManifest",
  "type": "object"
}
