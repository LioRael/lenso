{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        }
      },
      "required": [
        "locator",
        "digest"
      ],
      "type": "object"
    },
    "ConsoleModuleManifest": {
      "additionalProperties": false,
      "description": "The immutable presentation manifest embedded in a `console_ui_esm`\nartifact. Its field names intentionally match the public Console SDK.",
      "properties": {
        "consoleUi": {
          "type": "string"
        },
        "hostApi": {
          "type": "string"
        },
        "moduleId": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "surfaces": {
          "items": {
            "$ref": "#/$defs/ConsoleModuleSurface"
          },
          "type": "array"
        }
      },
      "required": [
        "protocol",
        "moduleId",
        "hostApi",
        "consoleUi",
        "surfaces"
      ],
      "type": "object"
    },
    "ConsoleModuleSurface": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "$ref": "#/$defs/ConsoleSurfaceArea"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "navigation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConsoleNavigation"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "requiredCapabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "path",
        "label",
        "area"
      ],
      "type": "object"
    },
    "ConsoleNavigation": {
      "properties": {
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConsoleNavigationGroup"
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "workspace": {
          "$ref": "#/$defs/ConsoleWorkspaceRef"
        }
      },
      "required": [
        "workspace"
      ],
      "type": "object"
    },
    "ConsoleNavigationGroup": {
      "properties": {
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "order": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    },
    "ConsolePermissionRequest": {
      "properties": {
        "operations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "outboundDestinations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "permissionId": {
          "type": "string"
        },
        "resources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "secretReferences": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "permissionId"
      ],
      "type": "object"
    },
    "ConsoleSurfaceArea": {
      "enum": [
        "runtime",
        "operations",
        "data",
        "configuration"
      ],
      "type": "string"
    },
    "ConsoleUiArtifactEntry": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path"
      ],
      "type": "object"
    },
    "ConsoleUiArtifactFormat": {
      "enum": [
        "console_ui_esm"
      ],
      "type": "string"
    },
    "ConsoleUiArtifactStyleAsset": {
      "additionalProperties": false,
      "properties": {
        "media": {
          "type": [
            "string",
            "null"
          ]
        },
        "order": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "ConsoleWorkspaceRef": {
      "properties": {
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    }
  },
  "$id": "https://contracts.lenso.local/console/lenso.console-ui-esm.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ConsoleUiArtifactEntry"
      },
      "type": "array"
    },
    "entry": {
      "type": "string"
    },
    "format": {
      "const": "console_ui_esm",
      "type": "string"
    },
    "manifest": {
      "$ref": "#/$defs/ConsoleModuleManifest"
    },
    "protocolMajor": {
      "const": 1,
      "type": "integer"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "type": "array"
    },
    "requestedPermissions": {
      "items": {
        "$ref": "#/$defs/ConsolePermissionRequest"
      },
      "type": "array"
    },
    "styleAssets": {
      "items": {
        "$ref": "#/$defs/ConsoleUiArtifactStyleAsset"
      },
      "type": "array"
    }
  },
  "required": [
    "artifact",
    "format",
    "protocolMajor",
    "entry",
    "manifest"
  ],
  "title": "LensoConsoleUiEsmArtifact",
  "type": "object"
}
