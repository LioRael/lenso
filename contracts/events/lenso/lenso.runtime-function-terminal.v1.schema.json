{
  "$id": "https://lenso.dev/contracts/lenso.runtime-function-terminal.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "failureClassification": {
      "enum": [
        "permanent_failure",
        "retry_exhausted"
      ]
    },
    "failureCode": {
      "minLength": 1,
      "type": "string"
    },
    "functionName": {
      "minLength": 1,
      "type": "string"
    },
    "functionRunId": {
      "minLength": 1,
      "type": "string"
    },
    "ownerModule": {
      "minLength": 1,
      "type": "string"
    },
    "terminalState": {
      "const": "dead"
    }
  },
  "required": [
    "failureClassification",
    "failureCode",
    "functionName",
    "functionRunId",
    "ownerModule",
    "terminalState"
  ],
  "title": "lenso.runtime-function-terminal.v1",
  "type": "object"
}
