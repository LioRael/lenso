{
  "$defs": {
    "EnvironmentManagementMode": {
      "enum": [
        "disabled",
        "read_only",
        "full"
      ],
      "type": "string"
    }
  },
  "$id": "https://contracts.lenso.local/management/lenso.module-environment-policy.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "maximum_approval_age_seconds": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "maximum_lease_seconds": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "mode": {
      "$ref": "#/$defs/EnvironmentManagementMode"
    },
    "policy_id": {
      "type": "string"
    },
    "protocol": {
      "const": "lenso.module-environment-policy.v1",
      "type": "string"
    },
    "require_backup_for_non_local_destructive_effects": {
      "type": "boolean"
    },
    "require_distinct_approver": {
      "type": "boolean"
    },
    "revision": {
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "policy_id",
    "revision",
    "mode",
    "require_distinct_approver",
    "maximum_approval_age_seconds",
    "maximum_lease_seconds",
    "require_backup_for_non_local_destructive_effects"
  ],
  "title": "LensoModuleEnvironmentPolicy",
  "type": "object"
}
