{
  "$defs": {
    "ApplicationModuleLock": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "type": "string"
        },
        "capability_bindings": {
          "items": {
            "$ref": "#/$defs/LockedCapabilityBinding"
          },
          "type": "array"
        },
        "catalog_snapshot_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "desired_composition_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/LockedModule"
          },
          "type": "array"
        },
        "protocol": {
          "type": "string"
        },
        "resolver_version": {
          "type": "string"
        },
        "trust_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "application_id",
        "desired_composition_digest",
        "catalog_snapshot_digest",
        "trust_policy_digest",
        "resolver_version",
        "modules"
      ],
      "type": "object"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "locator": {
          "type": "string"
        }
      },
      "required": [
        "locator",
        "digest"
      ],
      "type": "object"
    },
    "AttestationReference": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "signer": {
          "type": "string"
        }
      },
      "required": [
        "locator",
        "digest",
        "issuer",
        "signer"
      ],
      "type": "object"
    },
    "DesiredModuleComposition": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "type": "string"
        },
        "local_overrides": {
          "items": {
            "$ref": "#/$defs/LocalModuleOverride"
          },
          "type": "array"
        },
        "protocol": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "selected": {
          "items": {
            "$ref": "#/$defs/DesiredModuleSelection"
          },
          "type": "array"
        }
      },
      "required": [
        "protocol",
        "application_id",
        "revision",
        "selected"
      ],
      "type": "object"
    },
    "DesiredModuleSelection": {
      "additionalProperties": false,
      "properties": {
        "delivery_preference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ManagedDeliveryKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "exact_release_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "module_id": {
          "type": "string"
        },
        "optional_requirements": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "version_requirement": {
          "type": "string"
        }
      },
      "required": [
        "module_id",
        "version_requirement"
      ],
      "type": "object"
    },
    "EnvironmentManagementMode": {
      "enum": [
        "disabled",
        "read_only",
        "full"
      ],
      "type": "string"
    },
    "LocalModuleOverride": {
      "additionalProperties": false,
      "properties": {
        "acknowledged_unverified": {
          "type": "boolean"
        },
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "module_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "module_id",
        "path",
        "content_digest",
        "acknowledged_unverified"
      ],
      "type": "object"
    },
    "LockedCapabilityBinding": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": "string"
        },
        "consumer_module_id": {
          "type": "string"
        },
        "provider_module_id": {
          "type": "string"
        }
      },
      "required": [
        "capability",
        "provider_module_id",
        "consumer_module_id"
      ],
      "type": "object"
    },
    "LockedConsoleArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_locator": {
          "type": "string"
        },
        "exports": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "host_api_version": {
          "type": "string"
        },
        "integrity": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "version",
        "artifact_locator",
        "integrity",
        "host_api_version",
        "exports"
      ],
      "type": "object"
    },
    "LockedModule": {
      "additionalProperties": false,
      "properties": {
        "console_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/LockedConsoleArtifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "crate_features": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "delivery": {
          "$ref": "#/$defs/ModuleDelivery"
        },
        "dependency_module_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lifecycle": {
          "$ref": "#/$defs/ModuleLifecycleState"
        },
        "local_override_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "migration_artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "type": "array"
        },
        "module_id": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/LockedModuleReason"
        },
        "release_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "verification": {
          "$ref": "#/$defs/VerificationEvaluation"
        },
        "verification_cell": {
          "$ref": "#/$defs/ModuleVerificationCell"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "module_id",
        "version",
        "release_digest",
        "manifest_digest",
        "delivery",
        "reason",
        "verification",
        "verification_cell",
        "lifecycle"
      ],
      "type": "object"
    },
    "LockedModuleReason": {
      "enum": [
        "direct",
        "transitive"
      ],
      "type": "string"
    },
    "ManagedDeliveryKind": {
      "enum": [
        "linked",
        "provider",
        "autonomous"
      ],
      "type": "string"
    },
    "ModuleDelivery": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "archive_checksum": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "attestations": {
              "items": {
                "$ref": "#/$defs/AttestationReference"
              },
              "type": "array"
            },
            "binding": {
              "type": "string"
            },
            "crate_version": {
              "type": "string"
            },
            "default_features": {
              "default": false,
              "type": "boolean"
            },
            "features": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "const": "linked",
              "type": "string"
            },
            "migrations": {
              "items": {
                "$ref": "#/$defs/ArtifactReference"
              },
              "type": "array"
            },
            "package": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "package",
            "crate_version",
            "archive_checksum",
            "binding"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "contract_digests": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "export": {
              "type": "string"
            },
            "kind": {
              "const": "service",
              "type": "string"
            },
            "responsibility_profile": {
              "$ref": "#/$defs/ServiceResponsibilityProfile"
            },
            "service_id": {
              "type": "string"
            },
            "service_release_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "service_release_version": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "service_id",
            "service_release_version",
            "service_release_digest",
            "export",
            "responsibility_profile"
          ],
          "type": "object"
        }
      ]
    },
    "ModuleEnvironmentPolicy": {
      "additionalProperties": false,
      "properties": {
        "maximum_approval_age_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maximum_lease_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/EnvironmentManagementMode"
        },
        "policy_id": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "require_backup_for_non_local_destructive_effects": {
          "type": "boolean"
        },
        "require_distinct_approver": {
          "type": "boolean"
        },
        "revision": {
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "policy_id",
        "revision",
        "mode",
        "require_distinct_approver",
        "maximum_approval_age_seconds",
        "maximum_lease_seconds",
        "require_backup_for_non_local_destructive_effects"
      ],
      "type": "object"
    },
    "ModuleLifecycleState": {
      "additionalProperties": false,
      "properties": {
        "deprecated": {
          "type": "boolean"
        },
        "security_blocked": {
          "type": "boolean"
        },
        "yanked": {
          "type": "boolean"
        }
      },
      "required": [
        "deprecated",
        "yanked",
        "security_blocked"
      ],
      "type": "object"
    },
    "ModuleManagementSnapshotStatus": {
      "enum": [
        "ready",
        "unconfigured",
        "invalid"
      ],
      "type": "string"
    },
    "ModuleVerificationCell": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "type": "string"
        },
        "cargo_version": {
          "type": "string"
        },
        "cli_version": {
          "type": "string"
        },
        "console_artifact_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "console_host_api_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "console_lock_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "delivery_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "features": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "host_version": {
          "type": "string"
        },
        "lenso_version": {
          "type": "string"
        },
        "management_engine_version": {
          "type": "string"
        },
        "module_release_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "node_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "operation": {
          "$ref": "#/$defs/VerificationOperation"
        },
        "os": {
          "type": "string"
        },
        "package_manager_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_digests": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "runner_image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "rust_version": {
          "type": "string"
        },
        "source_release_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "starter_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "store_engine": {
          "type": "string"
        },
        "store_version": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "module_release_digest",
        "operation",
        "lenso_version",
        "host_version",
        "cli_version",
        "starter_digest",
        "management_engine_version",
        "delivery_digest",
        "target",
        "os",
        "architecture",
        "runner_image_digest",
        "rust_version",
        "cargo_version",
        "store_engine",
        "store_version"
      ],
      "type": "object"
    },
    "ServiceResponsibilityProfile": {
      "enum": [
        "provider",
        "autonomous"
      ],
      "type": "string"
    },
    "VerificationEvaluation": {
      "additionalProperties": false,
      "properties": {
        "reason_code": {
          "type": "string"
        },
        "receipt_digests": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/VerificationState"
        }
      },
      "required": [
        "state",
        "reason_code"
      ],
      "type": "object"
    },
    "VerificationOperation": {
      "enum": [
        "fresh_install",
        "upgrade",
        "restore",
        "uninstall"
      ],
      "type": "string"
    },
    "VerificationState": {
      "enum": [
        "verified",
        "failed",
        "unknown"
      ],
      "type": "string"
    }
  },
  "$id": "https://contracts.lenso.local/management/lenso.module-management-snapshot.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "application_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "application_lock": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApplicationModuleLock"
        },
        {
          "type": "null"
        }
      ]
    },
    "application_lock_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "desired": {
      "anyOf": [
        {
          "$ref": "#/$defs/DesiredModuleComposition"
        },
        {
          "type": "null"
        }
      ]
    },
    "desired_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModuleEnvironmentPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_available": {
      "type": "boolean"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "planning_available": {
      "type": "boolean"
    },
    "planning_context_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "protocol": {
      "const": "lenso.module-management-snapshot.v1",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ModuleManagementSnapshotStatus"
    }
  },
  "required": [
    "protocol",
    "status",
    "planning_available",
    "execution_available"
  ],
  "title": "LensoModuleManagementSnapshot",
  "type": "object"
}
