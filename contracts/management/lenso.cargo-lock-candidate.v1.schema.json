{
  "$defs": {
    "CargoPackageChange": {
      "additionalProperties": false,
      "properties": {
        "candidate_features": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "candidate_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "package": {
          "type": "string"
        },
        "previous_features": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "previous_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "package"
      ],
      "type": "object"
    }
  },
  "$id": "https://contracts.lenso.local/management/lenso.cargo-lock-candidate.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_lock_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "changed_packages": {
      "items": {
        "$ref": "#/$defs/CargoPackageChange"
      },
      "type": "array"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "current_lock_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "protocol": {
      "const": "lenso.cargo-lock-candidate.v1",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "current_lock_digest",
    "candidate_lock_digest",
    "changed_packages",
    "command"
  ],
  "title": "LensoCargoLockCandidate",
  "type": "object"
}
