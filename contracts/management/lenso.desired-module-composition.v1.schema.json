{
  "$defs": {
    "DesiredModuleSelection": {
      "additionalProperties": false,
      "properties": {
        "delivery_preference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ManagedDeliveryKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "exact_release_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "module_id": {
          "type": "string"
        },
        "optional_requirements": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "version_requirement": {
          "type": "string"
        }
      },
      "required": [
        "module_id",
        "version_requirement"
      ],
      "type": "object"
    },
    "LocalModuleOverride": {
      "additionalProperties": false,
      "properties": {
        "acknowledged_unverified": {
          "type": "boolean"
        },
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "module_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "module_id",
        "path",
        "content_digest",
        "acknowledged_unverified"
      ],
      "type": "object"
    },
    "ManagedDeliveryKind": {
      "enum": [
        "linked",
        "provider",
        "autonomous"
      ],
      "type": "string"
    }
  },
  "$id": "https://contracts.lenso.local/management/lenso.desired-module-composition.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "application_id": {
      "type": "string"
    },
    "local_overrides": {
      "items": {
        "$ref": "#/$defs/LocalModuleOverride"
      },
      "type": "array"
    },
    "protocol": {
      "const": "lenso.desired-module-composition.v1",
      "type": "string"
    },
    "revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "selected": {
      "items": {
        "$ref": "#/$defs/DesiredModuleSelection"
      },
      "type": "array"
    }
  },
  "required": [
    "protocol",
    "application_id",
    "revision",
    "selected"
  ],
  "title": "LensoDesiredModuleComposition",
  "type": "object"
}
