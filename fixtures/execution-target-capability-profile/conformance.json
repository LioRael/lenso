{
  "valid": [
    {
      "name": "every_v1_feature_is_representable",
      "profile": {
        "profile": "lenso.execution-target-capability-profile@1",
        "target_profile": "example.execution@1",
        "capabilities": [
          "browser",
          "event",
          "host-imports",
          "native-process",
          "remote",
          "request",
          "stream",
          "wasm-component",
          "websocket",
          "workers"
        ]
      },
      "required": ["request", "stream", "event", "websocket", "host-imports"],
      "missing": []
    },
    {
      "name": "omitted_declared_feature_is_not_inferred",
      "profile": {
        "profile": "lenso.execution-target-capability-profile@1",
        "target_profile": "example.request-only@1",
        "capabilities": ["request"]
      },
      "required": ["request", "stream", "workers"],
      "missing": ["stream", "workers"]
    },
    {
      "name": "empty_profile_explicitly_supports_nothing",
      "profile": {
        "profile": "lenso.execution-target-capability-profile@1",
        "target_profile": "example.no-runtime@1",
        "capabilities": []
      },
      "required": ["request"],
      "missing": ["request"]
    },
    {
      "name": "unknown_required_feature_fails_closed",
      "profile": {
        "profile": "lenso.execution-target-capability-profile@1",
        "target_profile": "example.request-only@1",
