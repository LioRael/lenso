{
  "id": "projects",
  "actions": [
    "projects.list",
    "projects.detail",
    "projects.create",
    "projects.archive"
  ],
  "tasks": [],
  "events": [],
  "resources": [
    "sqlite"
  ],
  "metadata": {
    "description": "Team projects",
    "version": "1",
    "capabilities": [
      "sqlite"
    ]
  },
  "actionMetadata": {
    "projects.list": {
      "description": "List projects in the caller's team",
      "capabilities": [
        "team.read"
      ],
      "effects": []
    },
    "projects.create": {
      "description": "Create a project in the caller's team",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Project display name"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "name": {
            "type": "string"
          },
          "archived": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": [
          "id",
          "name",
          "archived",
          "version"
        ],
        "additionalProperties": false
      },
      "capabilities": [
        "team.write"
      ],
      "effects": [
        "write:projects"
      ]
    }
  }
}
