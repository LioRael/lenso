{
  "name": "@lenso/sqlite",
  "version": "0.1.1",
  "description": "SQLite durable task and event delivery for Lenso on Node.js",
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
