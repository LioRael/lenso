{
  "name": "@lenso/app",
  "version": "0.1.0",
  "description": "Native TypeScript application primitives for Lenso",
  "type": "module",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {"types": "./dist/index.d.ts", "default": "./dist/index.js"},
    "./action": {"types": "./dist/action.d.ts", "default": "./dist/action.js"},
    "./access": {"types": "./dist/access.d.ts", "default": "./dist/access.js"},
    "./resource": {"types": "./dist/resource.d.ts", "default": "./dist/resource.js"},
    "./module": {"types": "./dist/module.d.ts", "default": "./dist/module.js"},
    "./events": {"types": "./dist/events.d.ts", "default": "./dist/events.js"},
    "./console": {"types": "./dist/console.d.ts", "default": "./dist/console.js"},
    "./task": {"types": "./dist/task.d.ts", "default": "./dist/task.js"}
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
