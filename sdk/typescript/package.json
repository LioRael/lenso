{
  "name": "@lenso/typescript-sdk-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @lenso/service-kit build",
    "check": "pnpm check:service-contract-schema && pnpm build && pnpm test && pnpm typecheck",
    "check:service-contract-schema": "node scripts/generate-service-contract-schema.mjs --check",
    "generate:service-contract-schema": "node scripts/generate-service-contract-schema.mjs",
    "test": "vitest run packages/service-kit/src",
    "typecheck": "tsc -p packages/service-kit/tsconfig.build.json --noEmit --declaration false"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "7.0.2",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@11.5.0"
}
