    "drizzle-orm": "0.45.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@lenso/audit": "workspace:^",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@orpc/client": "2.0.0-beta.42",
