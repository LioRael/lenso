{
  "name": "@lenso/example-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "bun --eval \"import {generate} from '@lenso/engine'; await generate(process.cwd())\"",
    "dev": "lenso dev --workspace lenso.workspace.ts",
    "dev:companions": "LENSO_RUNTIME_EXTERNAL=1 bun src/dev.ts",
    "offline": "bun src/offline.ts",
    "start": "bun src/server.ts",
    "test": "bun run generate && bun test src",
    "typecheck": "bun run generate && tsc --noEmit -p tsconfig.json",
    "build": "bun run generate && bun build src/server.ts --outdir dist --target bun --packages external"
  },
  "dependencies": {
    "@lenso/cache": "workspace:^",
    "@lenso/core": "workspace:^",
    "@lenso/engine": "workspace:^",
    "@lenso/log": "workspace:^",
    "@lenso/runtime": "workspace:^",
    "@lenso/runtime-sdk": "workspace:*",
    "@standard-schema/spec": "1.1.0"
  },
  "devDependencies": {
    "@lenso/cli": "workspace:^"
  }
}
