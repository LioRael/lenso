[package]
name = "lenso-linked-runtime-consumer"
version = "0.0.0"
edition = "2024"
publish = false
rust-version = "1.94"

[workspace]

[dependencies]
async-trait = "0.1"
lenso = { path = "__LENSO_PACKAGE_PATH__", features = ["host"] }
serde_json = "1"
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
