{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "local_note": {"type": "string", "minLength": 1}
  },
  "type": "object",
  "required": ["name", "signed", "unsigned", "payload", "timestamp", "duration", "values"],
  "properties": {
    "name": {"$ref": "common-name.schema.json"},
    "kind": {"type": "string", "enum": ["alpha", "beta"]},
    "signed": {"type": "string", "format": "int64"},
    "unsigned": {"type": "string", "format": "uint64"},
    "payload": {"type": "string", "format": "byte"},
    "timestamp": {"type": "string", "format": "date-time"},
    "duration": {"type": "string", "format": "duration"},
    "values": {"type": "array", "items": {"type": "integer"}},
    "nullable_values": {"type": "array", "items": {"type": ["string", "null"]}},
    "nullable_map": {"type": "object", "additionalProperties": {"type": ["integer", "null"]}},
    "optional_note": {"type": ["string", "null"]},
    "local_note": {"$ref": "#/$defs/local_note"}
  },
  "additionalProperties": false
}
