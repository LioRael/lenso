[package]
name = "local-starter"
version = "0.1.0"
edition = "2024"
publish = false

[package.metadata.lenso]
plugin-id = "local.starter"
root-slot = "web"

[package.metadata.lenso-cli]
runtime = "process"

[dependencies]
lenso-capability-http-endpoint = { version = "=0.3.4", features = ["process"] }
serde = { version = "1", features = ["derive"] }

[dev-dependencies]
futures = "0.3"
serde_json = "1"

[workspace]
